!CLEAR
!LSHIFT 1 7
!RSHIFT 6 4
!VSHIFT RSHIFT
!SHIFTL LSHIFT
!LCBM 7 5
!VCBM LCBM
!LCTRL 7 2
!VCTRL LCTRL
#####################
# |Bit 0| DEL |Retrn|C_L/R|  F7 |  F1 |  F3 |  F5 |C_U/D|

BackSpace       0 0 8
Delete          0 0 8
Insert          0 0 1
Return          0 1 8
Right           0 2 8
KP_F4           0 2 8
Left            0 2 1
F7              0 3 8
F8              0 3 1
F1              0 4 8
KP_F1           0 4 8
F2              0 4 1
KP_F2           0 5 8
F3              0 5 8
F4              0 5 1
F5              0 6 8
KP_F3           0 6 8
F6              0 6 1
Down            0 7 8
Up              0 7 1

#####################
# |Bit 1| 3 # |  W  |  A  | 4 $ |  Z  |  S  |  E  | S_L |

numbersign      1 0 1
dollar          1 3 1
Shift_L         1 7 2
Caps_Lock       1 7 64
Control_L	7 5 8200 /* Caps Lock = Commodore */

#####################
# |Bit 2| 5 % |  R  |  D  | 6 & |  C  |  F  |  T  |  X  |

percent         2 0 1
ampersand       2 3 1

#####################
# |Bit 3| 7 ' |  Y  |  G  | 8 ( |  B  |  H  |  U  |  V  |

apostrophe      3 0 1
grave           3 0 1
parenleft       3 3 1

#####################
# |Bit 4| 9 ) |  I  |  J  |  0  |  M  |  K  |  O  |  N  |

parenright      4 0 1

#####################
# |Bit 5|  +  |  P  |  L  |  -  | . > | : [ |  @  | , < |

plus            5 0 16
minus           5 3 0
period          5 4 0
greater         5 4 1
colon           5 5 16
bracketleft     5 5 1
at              5 6 16
underscore      5 6 0x810
comma           5 7 0
less            5 7 1

#####################
# |Bit 6|POUND|  *  | ; ] | HOME| S_R |  =  | A_UP| / ? |

sterling        6 0 0
backslash       6 0 0
bar             6 0 8
asterisk        6 1 16
semicolon       6 2 0
bracketright    6 2 1
Home            6 3 8
Shift_R         6 4 4
equal           6 5 0
asciicircum     6 6 16
Page_Down       6 6 8
slash           6 7 0
Alt_L           6 7 0
question        6 7 1

#####################
# |Bit 7| 1 ! |A_LFT| CTRL| 2 " |SPACE|  C= |  Q  | R/S |

exclam          7 0 1
asciitilde      7 1 16
End             7 1 0
Control_L       7 2 16392     
quotedbl        7 3 1
space           7 4 8
Tab             7 5 8200 /* Tab = C64 CTRL */
Escape          7 7 8

#####################
