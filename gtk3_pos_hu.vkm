# Restore key mappings
Page_Up -3 0
Prior -3 1

# Dead keys (HU layout)
dead_acute       3 0 1
dead_grave       3 0 1
dead_circumflex  6 6 16
dead_tilde       6 6 16
dead_diaeresis   7 3 1  

#
# joyport attached keypad
#
Num_Lock    -5 0
KP_7        -5 1
KP_8        -5 2
KP_9        -5 3
KP_Divide   -5 4
Scroll_Lock -5 5
KP_4        -5 6
KP_5        -5 7
KP_6        -5 8
KP_Multiply -5 9
Sys_Req     -5 10
KP_1        -5 11
KP_2        -5 12
KP_3        -5 13
KP_Subtract -5 14
Print       -5 15
KP_0        -5 16
KP_Delete   -5 17
KP_Enter    -5 18
KP_Add      -5 19

# numeric keyboard
# switch off the "Allow keyset joystiks" in Preferences
# to have the numbers
KP_1        7 0 0
KP_2        7 3 0
KP_3        1 0 0
KP_4        1 3 0
KP_5        2 0 0
KP_6        2 3 0
KP_7        3 0 0
KP_8        3 3 0
KP_9        4 0 0
KP_0        4 3 0

KP_Divide   6 7 0   # slash
KP_Multiply 6 1 16  # *
KP_Subtract 5 3 0   # -
KP_Add      5 0 16  # +
KP_Enter    0 1 8   # RETURN
KP_Delete   0 0 8   # DEL

